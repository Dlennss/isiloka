[Service]
Type=oneshot
User=pulsakilat
Group=deployers
WorkingDirectory=/home/syarif/app/releases/pulsa-be/current
Environment=P24_ADMIN_BUSINESS_CACHE_DAYS_BACK=1
ExecStart=/home/syarif/app/releases/pulsa-be/current/scripts/refresh_admin_daily_business_cache.sh
Nice=5
